# Copy this file to .env at the repository root before starting the local stack.
#
# All values below are local-development defaults. They are deliberately
# centralized here so scripts, Docker Compose, the backend and Vite read the
# same configuration.

# Dots app
PORT=4000
APP_ORIGIN=http://localhost:3002
VITE_DOTS_URL=http://localhost:3002
VITE_DOCS_URL=http://localhost:3000
DOTS_API_PROXY=http://localhost:4000

# Dots OIDC client, imported in the local Keycloak realm
OIDC_ISSUER=http://localhost:8083/realms/lasuite
OIDC_CLIENT_ID=interop-app
OIDC_CLIENT_SECRET=dots-local-interop-secret
OIDC_REDIRECT_URI=http://localhost:3002/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:3002/login
OIDC_SCOPE="openid email profile"

# Docs external API used by Dots
DOCS_API_BASE_URL=http://localhost:8071/external_api/v1.0/
DOCS_API_TIMEOUT_MS=10000
DOCS_API_MAX_RESPONSE_BYTES=5242880
TYPST_TEMPLATES_API_BASE_URL=http://localhost:8071/external_api/v1.0/typst-templates/
TYPST_TEMPLATES_API_TIMEOUT_MS=10000
TYPST_TEMPLATES_API_MAX_RESPONSE_BYTES=5242880

# Local Keycloak
KEYCLOAK_REALM=lasuite
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=dots-local-admin-password
KEYCLOAK_POSTGRES_DB=keycloak
KEYCLOAK_POSTGRES_USER=keycloak
KEYCLOAK_POSTGRES_PASSWORD=dots-local-postgres-password
LASUITE_AUTH_PORT=8083
KEYCLOAK_INTERNAL_URL=http://lasuite-keycloak:8080

# Local demo users imported in Keycloak
DEMO_USER_1_USERNAME=demo1
DEMO_USER_1_PASSWORD=demo1
DEMO_USER_1_EMAIL=demo1@lasuite.local
DEMO_USER_1_FIRST_NAME=Demo
DEMO_USER_1_LAST_NAME=Demo
DEMO_USER_2_USERNAME=demo2
DEMO_USER_2_PASSWORD=demo2
DEMO_USER_2_EMAIL=demo2@lasuite.local
DEMO_USER_2_FIRST_NAME=Demo
DEMO_USER_2_LAST_NAME=User

# Docs OIDC client, imported in the local Keycloak realm
DOCS_OIDC_CLIENT_ID=impress
DOCS_OIDC_CLIENT_SECRET=dots-local-docs-secret
DOCS_OIDC_ALLOWED_AUDIENCE=interop-app

# Local Docs stack ports and public URLs
DOCS_FRONTEND_PORT=3000
DOCS_BACKEND_PORT=8071
DOCS_NGINX_PORT=8183
DOCS_KEYCLOAK_PORT=18080
DOCS_KC_POSTGRES_PORT=15433
DOCS_POSTGRES_PORT=15432
DOCS_MAILCATCHER_PORT=1081
DOCS_MINIO_PORT=9000
DOCS_MINIO_CONSOLE_PORT=9001
DOCS_Y_PROVIDER_PORT=4444
DOCS_DOCSPEC_PORT=4000
DOCS_API_ORIGIN=http://localhost:8071
DOCS_FRONTEND_URL=http://localhost:3000
DOCS_BACKEND_URL=http://localhost:8071
DOCS_MEDIA_URL=http://localhost:8183
DOCS_COLLABORATION_WS_URL=ws://localhost:4444/collaboration/ws/

# Optional AI assistant. Leave empty to disable the AI route.
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
DOTS_AI_MODEL=claude-sonnet-5
DOTS_AI_MAX_TOKENS=16384
#DOTS_AI_PATCH=1
#DOTS_AI_EFFORT=low
#DOTS_AI_TRACE=1
