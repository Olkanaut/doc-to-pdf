# Copier en backend/.env (ignoré par git). Sans clé, l'assistant IA répond 503 et l'interface le cache.
ANTHROPIC_API_KEY=
DOTS_AI_MODEL=claude-sonnet-5
# Jetons de sortie max par appel (un template complet en demande souvent > 4096).
DOTS_AI_MAX_TOKENS=16384
# Seulement si la clé n'est pas rattachée à un espace de travail (console Anthropic → Workspaces) : wrkspc_…
ANTHROPIC_WORKSPACE_ID=
# Réponse abrégée de l'assistant : il renvoie les seuls champs modifiés du JSON au lieu de
# recopier la template entière, et le serveur régénère le bloc. Mesuré 4× plus rapide, mais
# le banc complet n'a pas tranché : décommenter pour l'essayer (obligatoire pour la démo).
#DOTS_AI_PATCH=1
# Profondeur de réflexion du modèle : low raccourcit la réponse sans perte mesurée sur 5 cas.
#DOTS_AI_EFFORT=low
# Journalise les compteurs de jetons de chaque appel (cache, sortie). Diagnostic seulement.
#DOTS_AI_TRACE=1

# API REST de Docs (La Suite), lue par GET /api/docs/:id, POST /api/render {docId} et la
# galerie de gabarits. Le backend y relaie le jeton de la session OIDC.
# Le chemin complet est attendu, pas la racine du service.
DOCS_API_BASE_URL=http://localhost:8071/external_api/v1.0/
