# Copier en backend/.env (ignoré par git). Sans clé, l'assistant IA répond 503 et l'interface le cache.
ANTHROPIC_API_KEY=
DOTS_AI_MODEL=claude-sonnet-5
# Jetons de sortie max par appel (un template complet en demande souvent > 4096).
DOTS_AI_MAX_TOKENS=16384
# Seulement si la clé n'est pas rattachée à un espace de travail (console Anthropic → Workspaces) : wrkspc_…
ANTHROPIC_WORKSPACE_ID=
# API REST de Docs (La Suite), lue par GET /api/docs/:id et POST /api/render {docId}.
# Le backend y relaie le cookie docs_sessionid du navigateur pour les documents non publics.
DOCS_API_URL=http://localhost:8071
