                  }
                ]
              }
            ]
          },
          {
            "cells": [
              {
                "content": [
                  {
                    "type": "text",
                    "text": "Abstentions"
                  }
                ]
              },
              {
                "content": [
                  {
                    "type": "text",
                    "text": "1"
                  }
                ]
              },
              {
                "content": [
                  {
                    "type": "text",
                    "text": "Mme Claire Marge"
                  }
                ]
              }
            ]
          },
          {
            "cells": [
              {
                "content": [
                  {
                    "type": "text",
                    "text": "Ne prend pas part au vote"
                  }
                ]
              },
              {
                "content": [
                  {
                    "type": "text",
                    "text": "1"
                  }
                ]
              },
              {
                "content": [
                  {
                    "type": "text",
                    "text": "Mme Inès Puce (article L. 2131-11 du CGCT)"
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "La délibération est "
        },
        {
          "type": "text",
          "text": "adoptée à la majorité des suffrages exprimés",
          "styles": {
            "bold": true
          }
        },
        {
          "type": "text",
          "text": "."
        }
      ]
    },
    {
      "type": "heading",
      "props": {
        "level": 2
      },
      "content": [
        {
          "type": "text",
          "text": "Publication et transmission"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Ainsi fait et délibéré les jour, mois et an que dessus."
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Transmise au représentant de l’État (Préfecture de la Vallée-d’Exemple, bureau du contrôle de légalité) le 14 septembre 2026 par voie dématérialisée ; numéro d’accusé de réception ACTES : [à compléter]."
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Publiée sous forme électronique sur le "
        },
        {
          "type": "link",
          "href": "https://www.saint-fixture.exemple.fr/deliberations",
          "content": [
            {
              "type": "text",
              "text": "site internet de la commune"
            }
          ]
        },
        {
          "type": "text",
          "text": " le 15 septembre 2026 et affichée en mairie du 15 septembre au 15 novembre 2026 (article L. 2131-1 du CGCT)."
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "P.J. :",
          "styles": {
            "bold": true
          }
        },
        {
          "type": "text",
          "text": " projet de convention d’objectifs 2026 (fichier convention_amis-fixture_2026.pdf, 4 pages)."
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Copie à :",
          "styles": {
            "bold": true
          }
        },
        {
          "type": "text",
          "text": " Mme la présidente de l’association « Les Amis de la Fixture » ; M. Bruno Cartouche, directeur général des services — bruno.cartouche@exemple.gouv.fr."
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Pour extrait conforme, le maire,"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Hélène Fixturel",
          "styles": {
            "bold": true
          }
        }
      ]
    }
  ]
}
